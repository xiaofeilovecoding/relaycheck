{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relaycheck.local/schemas/manifest.schema.json",
  "title": "RelayCheck snapshot manifest (schema 1, canonical JSON / RFC 8785 subset)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "scope", "files", "excluded"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "relaycheck_snapshot" },
    "scope": { "type": "string" },
    "files": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mode", "size", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 512,
            "description": "relative, '/'-separated; sorted by UTF-8 bytes in the canonical form"
          },
          "mode": { "type": "string", "pattern": "^[0-7]{6}$" },
          "size": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": { "type": "string", "maxLength": 512 },
          "reason": { "type": "string", "maxLength": 64 }
        }
      }
    }
  }
}
